// forge-app on the web: the browser host. Phase 9a, see ../../../PLAN.md.
//
// This module is web-only (it reaches `web_wasm` and forge-webgl) and is NOT
// re-exported from `lib.mo`, so the native test binary never links it. A web
// game uses exactly two modules: `forge_app` (build the `App`) and
// `forge_app::web` (run it). Its bin holds three thunks:
//
//     #[export "c"]
//     def oak_mount : IO Unit := web_mount my_app my_rig
//
//     #[export "c"]
//     def oak_dispatch_event (handler : I64) : IO Unit := web_dispatch handler
//
//     #[export "c"]
//     def oak_tick : IO Unit := web_tick
//
//     def main : IO Unit := IO.pure unit
//
// The export NAMES are the web loader's (`wasm/web/web.js`, generated by
// `web_wasm`'s `Glue.loader`): it calls `oak_mount` once, `oak_dispatch_event`
// for every registered listener, and only starts its `requestAnimationFrame`
// loop when an `oak_tick` export exists. Nothing here uses oak itself.
//
// One frame (animation-frame handler):
//   dt from successive rAF timestamps (clamped, so a background tab does not
//   come back with a 30-second step) -> refit the canvas -> the rig's camera
//   for the current aspect -> `app_frame_dt` -> `app_plan` -> `webgl_submit`.
// A click picks: the cursor's offset in the canvas -> `camera_screen_ray`
// -> `pick_entity` against the LAST frame's world (what is on screen).
//
// State between exports lives in one `Ref WebState`, stashed in the host with
// `Keep.save` (an export's ABI is plain words; no Monad value crosses it).
// `Keep` is a single slot, so a page runs one forge app, and not alongside
// an oak program (which uses the same slot).

use std::ref {Ref, Ref.new, Ref.get, Ref.set}
use init::copy {Copy}
use web_wasm::types {Node}
use web_wasm::dom {Dom.on, Dom.on_frame, Dom.root, Dom.create, Dom.set_attr, Dom.append, Dom.text_node}
use web_wasm::event {WebEvent.current}
use web_wasm::keep {Keep.save, Keep.load}
use web_wasm::console {Console.log}
use forge_core::ecs {World, Entity, entity_id}
use forge_render {Camera, FramePlan, Picked, camera_screen_ray, pick_entity}
use forge_webgl {
    WebGlRenderer, webgl_create, webgl_submit, webgl_resize, webgl_client_size,
    webgl_canvas, Size2, size_width, size_height
}
use lib::app {
    App, CameraRig, rig_camera, Frame, frame_world, app_set_camera, app_initial_world,
    app_assets, app_frame_dt, app_plan
}

pub use forge_webgl {
    WebGlRenderer, webgl_create, webgl_attach, webgl_submit, webgl_resize, webgl_rebuild,
    webgl_set_assets, webgl_version, webgl_is_lost, webgl_client_size
}

/// The handler ids this host registers with the loader.
pub def web_frame_handler : I64 := 1

pub def web_click_handler : I64 := 2

/// The longest step one frame may take, in seconds.
pub def web_max_dt : F64 := 0.25

/// Everything the exports share. `Copy` (identity): an immutable app, a
/// renderer handle, a persistent world.
pub struct WebState {
    app : App,
    renderer : WebGlRenderer,
    rig : CameraRig,
    world : World,
    last_ms : F64,
    frames : I64,
    picked : I64
}

pub instance Copy WebState {
    def copy (s : WebState) : Pair WebState WebState := Pair.pair s s
}

def web_state (app : App) (renderer : WebGlRenderer) (rig : CameraRig) (world : World)
    (last_ms : F64) (frames : I64) (picked : I64) : WebState :=
    { app := app, renderer := renderer, rig := rig, world := world, last_ms := last_ms,
      frames := frames, picked := picked
      : WebState }

/// Frame `dt` in seconds from two rAF timestamps in milliseconds (0 on the
/// first frame, clamped to `web_max_dt`).
pub def web_dt (last_ms : F64) (now_ms : F64) : F64 :=
    if last_ms < 0.0 then 0.0
    else
        let dt : F64 := (now_ms - last_ms) / 1000.0 in
        if dt < 0.0 then 0.0 else if dt > web_max_dt then web_max_dt else dt

// ── Status line ─────────────────────────────────────────────────────

/// Put `text` on the page as `<span id="forge-status">` (and the console):
/// the one place a setup failure is visible without devtools.
def report (text : String) : IO Unit := do {
    let root <- Dom.root;
    let span <- Dom.create "span";
    let _ <- Dom.set_attr span "id" "forge-status";
    let t <- Dom.text_node text;
    let _ <- Dom.append span t;
    let _ <- Dom.append root span;
    Console.log text
}

// ── Mount ───────────────────────────────────────────────────────────

def mounted (a : App) (rig : CameraRig) (r : WebGlRenderer) : IO Unit := do {
    let st : WebState := web_state a r rig (app_initial_world a) (0.0 - 1.0) 0 (0 - 1);
    let cell <- Ref.new st;
    let _ <- Keep.save cell;
    let _ <- Dom.on_frame (I64.to_string web_frame_handler);
    Dom.on (webgl_canvas r) "click" web_click_handler
}

/// Create a full-size canvas, bring up WebGL with the app's assets, and
/// start driving frames. A failure (no WebGL, a shader error) is reported on
/// the page and nothing is driven.
pub def web_mount (a : App) (rig : CameraRig) : IO Unit := do {
    let created <- webgl_create (app_assets a);
    match created {
        Result.err e => report (String.concat "forge: " e),
        Result.ok r => mounted a rig r,
    }
}

// ── Frames ──────────────────────────────────────────────────────────

def load_state : IO (Ref WebState) := Keep.load

def event_time : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.time_stamp
}

def event_x : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.offset_x
}

def event_y : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.offset_y
}

def camera_for (rig : CameraRig) (size : Size2) : Camera :=
    rig_camera rig (size_width size) (size_height size)

def frame_with (cell : Ref WebState) (st : WebState) (now : F64) (size : Size2) : IO Unit := do {
    let a : App := app_set_camera st.app (camera_for st.rig size);
    let f : Frame := app_frame_dt a st.world (web_dt st.last_ms now);
    let plan : FramePlan := app_plan a f;
    let _ <- webgl_submit st.renderer plan;
    Ref.set cell (web_state st.app st.renderer st.rig (frame_world f) now
                    (I64.add st.frames 1) st.picked)
}

/// One animation frame.
pub def web_frame : IO Unit := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    frame_from cell st
}

/// `st` arrives as a typed PARAMETER: a `<-`-bound value is affine as a bare
/// type variable however it is annotated (gap G3), a parameter is `Copy`.
def frame_from (cell : Ref WebState) (st : WebState) : IO Unit := do {
    let now <- event_time;
    let _ <- webgl_resize st.renderer;
    let size <- webgl_client_size st.renderer;
    frame_with cell st now size
}

// ── Picking ─────────────────────────────────────────────────────────

def picked_id (o : Option Picked) : I64 :=
    match o {
        Option.some p0 =>
            let p : Picked := p0 in
            U64.to_i64 (entity_id p.entity),
        Option.none => 0 - 1
    }

/// The entity id under canvas point `(x, y)` (CSS pixels), or -1.
pub def web_pick_at (st : WebState) (size : Size2) (x : F64) (y : F64) : I64 :=
    let cam : Camera := camera_for st.rig size in
    match camera_screen_ray cam (size_width size) (size_height size) x y {
        Option.none => 0 - 1,
        Option.some r => picked_id (pick_entity st.world (app_assets st.app) r)
    }

def click_with (cell : Ref WebState) (st : WebState) (size : Size2) (x : F64) (y : F64) : IO Unit := do {
    let id : I64 := web_pick_at st size x y;
    let _ <- Dom.set_attr (webgl_canvas st.renderer) "data-picked" (I64.to_string id);
    Ref.set cell (web_state st.app st.renderer st.rig st.world st.last_ms st.frames id)
}

/// A click on the canvas: pick, record the id on the state and as the
/// canvas's `data-picked` attribute (what a page script or a test reads).
pub def web_click : IO Unit := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    click_from cell st
}

def click_from (cell : Ref WebState) (st : WebState) : IO Unit := do {
    let size <- webgl_client_size st.renderer;
    let x <- event_x;
    let y <- event_y;
    click_with cell st size x y
}

/// The entity id the last click picked (-1 for none).
pub def web_last_pick : IO I64 := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    IO.pure st.picked
}

// ── Export bodies ───────────────────────────────────────────────────

/// The `oak_dispatch_event` body: route a handler id.
pub def web_dispatch (handler : I64) : IO Unit :=
    if I64.beq handler web_frame_handler then web_frame
    else if I64.beq handler web_click_handler then web_click
    else IO.pure unit

/// The `oak_tick` body. Frames arrive as dispatches (the loader calls the
/// frame handler BEFORE `oak_tick`), so there is nothing left to do here;
/// the export exists because the loader only starts its rAF loop when it
/// finds one.
pub def web_tick : IO Unit := IO.pure unit
