// forge-app on the web: the browser host. Phase 9a, see ../../../PLAN.md.
//
// This module is web-only (it reaches `web_wasm` and forge-webgl) and is NOT
// re-exported from `lib.mo`, so the native test binary never links it. A web
// game uses exactly two modules: `forge_app` (build the `App`) and
// `forge_app::web` (run it). Its bin holds three thunks:
//
//     #[export "c"]
//     def oak_mount : IO Unit := web_mount my_app my_rig
//
//     #[export "c"]
//     def oak_dispatch_event (handler : I64) : IO Unit := web_dispatch handler
//
//     #[export "c"]
//     def oak_tick : IO Unit := web_tick
//
//     def main : IO Unit := IO.pure unit
//
// The export NAMES are the web loader's (`wasm/web/web.js`, generated by
// `web_wasm`'s `Glue.loader`): it calls `oak_mount` once, `oak_dispatch_event`
// for every registered listener, and only starts its `requestAnimationFrame`
// loop when an `oak_tick` export exists. Nothing here uses oak itself.
//
// One frame (animation-frame handler):
//   dt from successive rAF timestamps (clamped, so a background tab does not
//   come back with a 30-second step) -> refit the canvas -> the rig's camera
//   for the current aspect -> `app_frame_dt` -> `app_plan` -> `webgl_submit`.
// A click picks: the cursor's offset in the canvas -> `camera_screen_ray`
// -> `pick_entity` against the LAST frame's world (what is on screen).
//
// State between exports lives in one `Ref WebState`, stashed in the host with
// `Keep.save` (an export's ABI is plain words; no Monad value crosses it).
// `Keep` is a single slot, so a page runs one forge app, and not alongside
// an oak program (which uses the same slot).

use std::ref {Ref, Ref.new, Ref.get, Ref.set}
use init::copy {Copy}
use web_wasm::types {Node}
use web_wasm::dom {Dom.on, Dom.on_with, Dom.on_window, Dom.on_frame, Dom.root, Dom.create, Dom.set_attr, Dom.append, Dom.text_node}
use web_wasm::event {WebEvent.current, WebEvent.prevent_default}
use web_wasm::keep {Keep.save, Keep.load}
use web_wasm::console {Console.log}
use forge_core::ecs {World, Entity, entity_id}
use forge_render {Camera, FramePlan, Picked, camera_screen_ray, pick_entity}
use forge_webgl {
    WebGlRenderer, webgl_create, webgl_submit, webgl_resize, webgl_client_size,
    webgl_canvas, Size2, size_width, size_height
}
use lib::app {
    App, CameraRig, rig_camera, Frame, frame_world, app_set_camera, app_initial_world,
    app_assets, app_frame_viewed, app_plan
}
use lib::orbit {world_camera_rig}
use lib::hud {Hud, HudEntry, hud_empty, world_hud, hud_changes}
use lib::pick {world_pick}
use lib::input {
    Input, InputEvent, input_empty, input_apply, input_end_frame,
    input_key_down, input_key_up, input_pointer_move, input_pointer_down, input_pointer_up,
    input_pointer_leave, input_wheel, input_focus_lost, input_wheel_pixels, input_is_scroll_key
}

pub use forge_webgl {
    WebGlRenderer, webgl_create, webgl_attach, webgl_submit, webgl_resize, webgl_rebuild,
    webgl_set_assets, webgl_version, webgl_is_lost, webgl_client_size
}

/// The handler ids this host registers with the loader.
pub def web_frame_handler : I64 := 1

pub def web_click_handler : I64 := 2

/// Every input listener (keys and focus on `window`, pointer and wheel on
/// the canvas) shares this id; the event's kind says which it was.
pub def web_input_handler : I64 := 3

/// The longest step one frame may take, in seconds.
pub def web_max_dt : F64 := 0.25

/// Everything the exports share. `Copy` (identity): an immutable app, a
/// renderer handle, a persistent world.
pub struct WebState {
    app : App,
    renderer : WebGlRenderer,
    rig : CameraRig,
    world : World,
    last_ms : F64,
    frames : I64,
    picked : I64,
    input : Input,
    hud : Hud
}

pub instance Copy WebState {
    def copy (s : WebState) : Pair WebState WebState := Pair.pair s s
}

def web_state (app : App) (renderer : WebGlRenderer) (rig : CameraRig) (world : World)
    (last_ms : F64) (frames : I64) (picked : I64) (input : Input) (hud : Hud) : WebState :=
    { app := app, renderer := renderer, rig := rig, world := world, last_ms := last_ms,
      frames := frames, picked := picked, input := input, hud := hud
      : WebState }

/// Frame `dt` in seconds from two rAF timestamps in milliseconds (0 on the
/// first frame, clamped to `web_max_dt`).
pub def web_dt (last_ms : F64) (now_ms : F64) : F64 :=
    if last_ms < 0.0 then 0.0
    else
        let dt : F64 := (now_ms - last_ms) / 1000.0 in
        if dt < 0.0 then 0.0 else if dt > web_max_dt then web_max_dt else dt

// ── Status line ─────────────────────────────────────────────────────

/// Put `text` on the page as `<span id="forge-status">` (and the console):
/// the one place a setup failure is visible without devtools.
def report (text : String) : IO Unit := do {
    let root <- Dom.root;
    let span <- Dom.create "span";
    let _ <- Dom.set_attr span "id" "forge-status";
    let t <- Dom.text_node text;
    let _ <- Dom.append span t;
    let _ <- Dom.append root span;
    Console.log text
}

// ── Mount ───────────────────────────────────────────────────────────

def mounted (a : App) (rig : CameraRig) (r : WebGlRenderer) : IO Unit := do {
    let st : WebState := web_state a r rig (app_initial_world a) (0.0 - 1.0) 0 (0 - 1) input_empty hud_empty;
    let cell <- Ref.new st;
    let _ <- Keep.save cell;
    let _ <- Dom.on_frame (I64.to_string web_frame_handler);
    let _ <- Dom.on (webgl_canvas r) "click" web_click_handler;
    listen_input (webgl_canvas r)
}

/// Keys and focus loss on `window` (the canvas need not have focus);
/// pointer and wheel on the canvas. The wheel listener prevents the page
/// from scrolling under the canvas (`d`).
def listen_input (canvas : Node) : IO Unit := do {
    let spec : String := I64.to_string web_input_handler;
    let _ <- Dom.on_window "keydown" spec;
    let _ <- Dom.on_window "keyup" spec;
    let _ <- Dom.on_window "blur" spec;
    let _ <- Dom.on canvas "pointermove" web_input_handler;
    let _ <- Dom.on canvas "pointerdown" web_input_handler;
    let _ <- Dom.on canvas "pointerup" web_input_handler;
    let _ <- Dom.on canvas "pointerleave" web_input_handler;
    // Right-drag orbits the camera: no context menu on the canvas.
    let _ <- Dom.on_with canvas "contextmenu" (String.concat spec ":d");
    Dom.on_with canvas "wheel" (String.concat spec ":d")
}

/// Create a full-size canvas, bring up WebGL with the app's assets, and
/// start driving frames. A failure (no WebGL, a shader error) is reported on
/// the page and nothing is driven.
pub def web_mount (a : App) (rig : CameraRig) : IO Unit := do {
    let created <- webgl_create (app_assets a);
    match created {
        Result.err e => report (String.concat "forge: " e),
        Result.ok r => mounted a rig r,
    }
}

// ── Frames ──────────────────────────────────────────────────────────

def load_state : IO (Ref WebState) := Keep.load

def event_time : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.time_stamp
}

def event_x : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.offset_x
}

def event_y : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.offset_y
}

def camera_for (rig : CameraRig) (size : Size2) : Camera :=
    rig_camera rig (size_width size) (size_height size)

/// The rig to view `world` with: the one a system published there (an
/// orbit camera), else the one `web_mount` was given.
def rig_for (st : WebState) (world : World) : CameraRig := world_camera_rig world st.rig

def view_of (st : WebState) (size : Size2) (world : World) : Camera :=
    camera_for (rig_for st world) size

def frame_with (cell : Ref WebState) (st : WebState) (now : F64) (size : Size2) : IO Unit := do {
    // The camera is taken from the world AFTER the systems ran, so an orbit
    // camera's move is drawn the frame it happens.
    let f : Frame := app_frame_viewed st.app st.world st.input (web_dt st.last_ms now) (view_of st size);
    let plan : FramePlan := app_plan st.app f;
    let _ <- webgl_submit st.renderer plan;
    let hud : Hud := world_hud (frame_world f);
    let _ <- mirror_hud (webgl_canvas st.renderer) (hud_changes st.hud hud);
    Ref.set cell (web_state st.app st.renderer st.rig (frame_world f) now
                    (I64.add st.frames 1) st.picked (input_end_frame st.input) hud)
}

/// Write each changed HUD entry to the canvas as `data-hud-<key>`.
#[terminating]
def mirror_hud (canvas : Node) (es : List HudEntry) : IO Unit :=
    match es {
        List.empty => IO.pure unit,
        List.cons e rest => mirror_one canvas e rest
    }

#[terminating]
def mirror_one (canvas : Node) (e : HudEntry) (rest : List HudEntry) : IO Unit := do {
    let _ <- Dom.set_attr canvas (String.concat "data-hud-" e.key) e.value;
    mirror_hud canvas rest
}

/// One animation frame.
pub def web_frame : IO Unit := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    frame_from cell st
}

/// `st` arrives as a typed PARAMETER: a `<-`-bound value is affine as a bare
/// type variable however it is annotated (gap G3), a parameter is `Copy`.
def frame_from (cell : Ref WebState) (st : WebState) : IO Unit := do {
    let now <- event_time;
    let _ <- webgl_resize st.renderer;
    let size <- webgl_client_size st.renderer;
    frame_with cell st now size
}

// ── Picking ─────────────────────────────────────────────────────────

def picked_id (o : Option Picked) : I64 :=
    match o {
        Option.some p0 =>
            let p : Picked := p0 in
            U64.to_i64 (entity_id p.entity),
        Option.none => 0 - 1
    }

/// The entity id under canvas point `(x, y)` (CSS pixels), or -1: the
/// nearest collider when the world has colliders, else the nearest mesh.
pub def web_pick_at (st : WebState) (size : Size2) (x : F64) (y : F64) : I64 :=
    let cam : Camera := camera_for (rig_for st st.world) size in
    match camera_screen_ray cam (size_width size) (size_height size) x y {
        Option.none => 0 - 1,
        Option.some r => world_pick st.world (app_assets st.app) r
    }

def click_with (cell : Ref WebState) (st : WebState) (size : Size2) (x : F64) (y : F64) : IO Unit := do {
    let id : I64 := web_pick_at st size x y;
    let _ <- Dom.set_attr (webgl_canvas st.renderer) "data-picked" (I64.to_string id);
    Ref.set cell (web_state st.app st.renderer st.rig st.world st.last_ms st.frames id st.input st.hud)
}

/// A click on the canvas: pick, record the id on the state and as the
/// canvas's `data-picked` attribute (what a page script or a test reads).
pub def web_click : IO Unit := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    click_from cell st
}

def click_from (cell : Ref WebState) (st : WebState) : IO Unit := do {
    let size <- webgl_client_size st.renderer;
    let x <- event_x;
    let y <- event_y;
    click_with cell st size x y
}

/// The entity id the last click picked (-1 for none).
pub def web_last_pick : IO I64 := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    IO.pure st.picked
}

// ── Input ───────────────────────────────────────────────────────────
//
// `WebEvent.current` is a snapshot whose binder is affine (gap G3), so each
// field is read by its own one-use getter, and only the fields the event's
// kind carries are read.

def event_kind : IO String := do {
    let e <- WebEvent.current;
    IO.pure e.kind
}

def event_code : IO String := do {
    let e <- WebEvent.current;
    IO.pure e.code
}

def event_button : IO I64 := do {
    let e <- WebEvent.current;
    IO.pure e.button
}

def event_delta_y : IO F64 := do {
    let e <- WebEvent.current;
    IO.pure e.delta_y
}

def event_delta_mode : IO I64 := do {
    let e <- WebEvent.current;
    IO.pure e.delta_mode
}

def key_event (down : Bool) : IO (Option InputEvent) := do {
    let code <- event_code;
    let _ <- if input_is_scroll_key code then WebEvent.prevent_default else IO.pure unit;
    IO.pure (Option.some (if down then input_key_down code else input_key_up code))
}

def move_event : IO (Option InputEvent) := do {
    let x <- event_x;
    let y <- event_y;
    IO.pure (Option.some (input_pointer_move x y))
}

def button_event (down : Bool) : IO (Option InputEvent) := do {
    let b <- event_button;
    let x <- event_x;
    let y <- event_y;
    IO.pure (Option.some (if down then input_pointer_down b x y else input_pointer_up b x y))
}

def wheel_event : IO (Option InputEvent) := do {
    let dy <- event_delta_y;
    let mode <- event_delta_mode;
    IO.pure (Option.some (input_wheel (input_wheel_pixels dy mode)))
}

/// The model event for the browser event in flight, if forge reads it.
def read_input_event (k : String) : IO (Option InputEvent) :=
    if k == "keydown" then key_event true
    else if k == "keyup" then key_event false
    else if k == "blur" then IO.pure (Option.some input_focus_lost)
    else if k == "pointermove" then move_event
    else if k == "pointerdown" then button_event true
    else if k == "pointerup" then button_event false
    else if k == "pointerleave" then IO.pure (Option.some input_pointer_leave)
    else if k == "wheel" then wheel_event
    else IO.pure Option.none

def input_with (cell : Ref WebState) (st : WebState) (ev : InputEvent) : IO Unit :=
    Ref.set cell (web_state st.app st.renderer st.rig st.world st.last_ms st.frames st.picked
                    (input_apply st.input ev) st.hud)

def input_from (cell : Ref WebState) (st : WebState) (o : Option InputEvent) : IO Unit :=
    match o {
        Option.none => IO.pure unit,
        Option.some ev => input_with cell st ev,
    }

/// An input event: fold it into the state the next frame installs.
pub def web_input : IO Unit := do {
    let k <- event_kind;
    let o <- read_input_event k;
    let cell <- load_state;
    let st <- Ref.get cell;
    input_from cell st o
}

/// The input the next frame will see.
pub def web_current_input : IO Input := do {
    let cell <- load_state;
    let st <- Ref.get cell;
    IO.pure st.input
}

// ── Export bodies ───────────────────────────────────────────────────

/// The `oak_dispatch_event` body: route a handler id.
pub def web_dispatch (handler : I64) : IO Unit :=
    if I64.beq handler web_frame_handler then web_frame
    else if I64.beq handler web_click_handler then web_click
    else if handler == web_input_handler then web_input
    else IO.pure unit

/// The `oak_tick` body. Frames arrive as dispatches (the loader calls the
/// frame handler BEFORE `oak_tick`), so there is nothing left to do here;
/// the export exists because the loader only starts its rAF loop when it
/// finds one.
pub def web_tick : IO Unit := IO.pure unit
