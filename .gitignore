# Build output. `/target` is the workspace root's store; a MEMBER-scoped
# command (`monad check motes/forge-app`, or the wasm build of a bin) writes
# a store beside that member instead, so the nested spelling is ignored too
# -- otherwise a member build leaves an untracked `motes/*/target/`.
/target
/motes/*/target
history.txt

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
docs/book

# Nightly release artifacts (scripts/nightly-release.sh). Build output: the
# release step uploads them from dist/, which git need not track.
dist/

# Plans directory for implementation planning
plans

# Agents
.opencode

# Python bytecode from the one-off migration scripts in scripts/
__pycache__/
*.pyc
